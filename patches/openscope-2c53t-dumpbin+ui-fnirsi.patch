+/*
+ * scope_topbar.h — FNIRSI-style status bar for the oscilloscope screen.
+ *
+ * One 18-px bar across the top carries everything the stock FNIRSI UI shows
+ * there: a filled chip per channel (CH1 cyan, CH2 blue) followed by that
+ * channel's volts/div, probe factor and coupling, a green "H" chip with the
+ * timebase, the trigger mode + edge + source in orange, and a battery icon.
+ * The bottom info bar is not drawn in the time-domain scope view any more;
+ * the graticule runs to the bottom of the screen instead.
+ *
+ * Geometry (x slots, font_small advances): see scope_topbar.c.
+ */
+#ifndef SCOPE_TOPBAR_H
+#define SCOPE_TOPBAR_H
+
+#include <stdint.h>
+
+#define SCOPE_TOPBAR_HEIGHT  18
+
+/* Full repaint of the bar (background, chips, H, trigger, battery). */
+void scope_topbar_draw(void);
+
+/* Battery icon only (called once a second by draw_status_bar). */
+void scope_topbar_draw_battery(void);
+
+#endif /* SCOPE_TOPBAR_H */
