+/* Bulk variant for scope_dumpbin: one usb_vcp_send_data() per buffer. The AT32
+ * USB ISR (usbd_int.c, usbd_eptn_handler) chains the 64-byte packets of a
+ * multi-packet transfer itself and only raises g_tx_completed at the end, so
+ * 1 KB leaves in a few ms instead of 16 tick-paced packets (~30 ms). The
+ * buffer must stay valid until the next send waits on g_tx_completed. */
+static void usb_send_bulk(const uint8_t *data, uint16_t len)
+{
+#if DEBUG_SHELL_RTT_ONLY
+    usb_send_bytes(data, len);
+#else
+    if (!usb_debug_connected()) return;
+    cdc_struct_type *pcdc = (cdc_struct_type *)usb_core_dev.class_handler->pdata;
+    uint32_t timeout = 1000;
+    while (!pcdc->g_tx_completed && --timeout) {
+        if (xTaskGetSchedulerState() == taskSCHEDULER_RUNNING)
+            vTaskDelay(1);
+    }
+    if (!timeout) return;
+    usb_vcp_send_data(&usb_core_dev, (uint8_t *)data, len);
+#endif
+}
