+    usb_debug_printf("auto power-off: %s (idle %lus, %s)\r\n",
+                     idle_off_get_minutes() ? "on" : "off", (unsigned long)idle_off_idle_seconds(),
+                     idle_off_asleep() ? "DARK SLEEP" : "awake");
