diff --git a/firmware/src/ui/scope_topbar.c b/firmware/src/ui/scope_topbar.c
new file mode 100644
index 0000000..1442fa3
--- /dev/null
+++ b/firmware/src/ui/scope_topbar.c
@@ -0,0 +1,195 @@
+/*
+ * scope_topbar.c — FNIRSI-style status bar for the oscilloscope screen.
+ *
+ * Reference: the stock FNIRSI 2C53P scope screen (480x272). Scaled to the
+ * 2C53T's 320x240 with the same reading order:
+ *
+ *   [CH1] 617mV X1 DC  [CH2] 2.8V X10 DC  [H 641us]  Auto ⎍1  [battery]
+ *
+ * Slot widths come from font_small's advance table ("617mV" = 36 px,
+ * "X10" = 19 px, "DC" = 15 px, "Auto" = 26 px, "CH1" = 21 px) — every text
+ * field is drawn with font_draw_string_box so it is clipped to its slot and
+ * repainted in place without blanking.
+ */
+#include "ui.h"
+#include "lcd.h"
+#include "font.h"
+#include "theme.h"
+#include "scope_state.h"
+#include "scope_cal.h"
+#include "scope_timebase.h"
+#include "battery.h"
+#include "scope_topbar.h"
+#include <stdio.h>
+#include <stdbool.h>
+
+#define BAR_H    SCOPE_TOPBAR_HEIGHT
+#define TXT_Y    3                 /* 12-px glyphs centred in the 18-px bar */
+
+#define CHIP_W   25
+#define VDIV_X   27                /* offsets inside a channel block */
+#define VDIV_W   39
+#define PROBE_X  68
+#define PROBE_W  19
+#define CPL_X    89
+#define CPL_W    16
+#define BLOCK_W  105
+
+#define CH1_X    0
+#define CH2_X    108
+#define H_X      216
+#define H_W      44
+#define TRIG_X   262
+#define TRIG_W   40
+#define BAT_X    304
+#define BAT_W    16
+
+static const char *cpl_short[COUPLING_COUNT] = { "DC", "AC", "GD" };
+
+static void outline(uint16_t x, uint16_t y, uint16_t w, uint16_t h, uint16_t c)
+{
+    lcd_fill_rect(x, y, w, 1, c);
+    lcd_fill_rect(x, (uint16_t)(y + h - 1), w, 1, c);
+    lcd_fill_rect(x, y, 1, h, c);
+    lcd_fill_rect((uint16_t)(x + w - 1), y, 1, h, c);
+}
+
+/* Channel chip: the active channel (the one the buttons adjust) is a filled
+ * box with a dark label, the other an outlined box with a coloured label. */
+static void chip(uint16_t x, const char *label, uint16_t color, bool active,
+                 const theme_t *th)
+{
+    if (active) {
+        lcd_fill_rect(x, 1, CHIP_W, BAR_H - 2, color);
+        font_draw_string_box(x, TXT_Y, CHIP_W, label, 0x0000, color,
+                             &font_small, FONT_ALIGN_CENTER);
+    } else {
+        lcd_fill_rect(x, 1, CHIP_W, BAR_H - 2, th->status_bar_bg);
+        outline(x, 1, CHIP_W, BAR_H - 2, color);
+        font_draw_string_box((uint16_t)(x + 1), TXT_Y, CHIP_W - 2, label, color,
+                             th->status_bar_bg, &font_small, FONT_ALIGN_CENTER);
+    }
+    /* rounded corners: knock the four corner pixels out to the bar colour */
+    lcd_set_pixel(x, 1, th->status_bar_bg);
+    lcd_set_pixel((uint16_t)(x + CHIP_W - 1), 1, th->status_bar_bg);
+    lcd_set_pixel(x, BAR_H - 2, th->status_bar_bg);
+    lcd_set_pixel((uint16_t)(x + CHIP_W - 1), BAR_H - 2, th->status_bar_bg);
+}
+
+static void channel_block(uint16_t x, uint8_t ch, const channel_state_t *cs,
+                          bool active, const theme_t *th)
+{
+    const uint16_t color = (ch == 1u) ? th->ch1 : th->ch2;
+    const uint16_t fg = cs->enabled ? color : th->text_secondary;
+    char v[12];
+
+    chip(x, (ch == 1u) ? "CH1" : "CH2", cs->enabled ? color : th->text_secondary,
+         active, th);
+    scope_cal_range_label(ch, cs->vdiv_idx, v, sizeof(v));
+    font_draw_string_box((uint16_t)(x + VDIV_X), TXT_Y, VDIV_W, v, fg,
+                         th->status_bar_bg, &font_small, FONT_ALIGN_LEFT);
+    font_draw_string_box((uint16_t)(x + PROBE_X), TXT_Y, PROBE_W,
+                         probe_labels[cs->probe], fg, th->status_bar_bg,
+                         &font_small, FONT_ALIGN_LEFT);
+    font_draw_string_box((uint16_t)(x + CPL_X), TXT_Y, CPL_W,
+                         cpl_short[cs->coupling], fg, th->status_bar_bg,
+                         &font_small, FONT_ALIGN_LEFT);
+}
+
+static void h_block(const scope_state_t *ss, const theme_t *th)
+{
+    char tb[12];
+
+    /* Green-outlined timebase chip (stock draws a clock glyph + "H" here; at
+     * 320 px the label alone fills the box: "2.56ms" is 39 px). */
+    lcd_fill_rect(H_X, 1, H_W, BAR_H - 2, th->status_bar_bg);
+    outline(H_X, 1, H_W, BAR_H - 2, th->success);
+    lcd_set_pixel(H_X, 1, th->status_bar_bg);
+    lcd_set_pixel(H_X + H_W - 1, 1, th->status_bar_bg);
+    lcd_set_pixel(H_X, BAR_H - 2, th->status_bar_bg);
+    lcd_set_pixel(H_X + H_W - 1, BAR_H - 2, th->status_bar_bg);
+    scope_timebase_label(ss->timebase_idx, tb, sizeof(tb));
+    font_draw_string_box(H_X + 2, TXT_Y, H_W - 4, tb, th->text_primary,
+                         th->status_bar_bg, &font_small, FONT_ALIGN_CENTER);
+}
+
+/* 5x7 edge glyph: a step with a foot and a head, rising or falling. */
+static void edge_glyph(uint16_t x, uint16_t y, bool rising, uint16_t c)
+{
+    if (rising) {
+        lcd_fill_rect(x, (uint16_t)(y + 6), 3, 1, c);        /* low foot, left */
+        lcd_fill_rect((uint16_t)(x + 2), y, 1, 7, c);        /* the edge */
+        lcd_fill_rect((uint16_t)(x + 2), y, 3, 1, c);        /* high head, right */
+    } else {
+        lcd_fill_rect(x, y, 3, 1, c);
+        lcd_fill_rect((uint16_t)(x + 2), y, 1, 7, c);
+        lcd_fill_rect((uint16_t)(x + 2), (uint16_t)(y + 6), 3, 1, c);
+    }
+}
+
+static void trig_block(const scope_state_t *ss, const theme_t *th)
+{
+    const char *mode;
+    uint16_t c;
+
+    if (!ss->running) {
+        mode = "STOP"; c = th->warning;
+    } else {
+        mode = (ss->trigger.mode == TRIG_AUTO)   ? "Auto" :
+               (ss->trigger.mode == TRIG_NORMAL) ? "Norm" : "Sngl";
+        c = th->highlight;
+    }
+    lcd_fill_rect(TRIG_X, 1, TRIG_W, BAR_H - 2, th->status_bar_bg);
+    uint16_t w = font_draw_string_box(TRIG_X, TXT_Y, 31, mode, c, th->status_bar_bg,
+                                      &font_small, FONT_ALIGN_LEFT);
+    const uint16_t sc = (ss->trigger.source == TRIG_SRC_CH1) ? th->ch1 : th->ch2;
+    uint16_t ax = (uint16_t)(TRIG_X + w + 2);
+    if (ax + 11 > TRIG_X + TRIG_W)
+        ax = (uint16_t)(TRIG_X + TRIG_W - 11);
+    edge_glyph(ax, TXT_Y + 2, ss->trigger.edge == TRIG_RISING, sc);
+    font_draw_string_box((uint16_t)(ax + 6), TXT_Y, 5,
+                         (ss->trigger.source == TRIG_SRC_CH1) ? "1" : "2", sc,
+                         th->status_bar_bg, &font_small, FONT_ALIGN_LEFT);
+}
+
+void scope_topbar_draw_battery(void)
+{
+    const theme_t *th = theme_get();
+    const uint8_t pct = battery_percent();
+    uint16_t col;
+
+    if (battery_is_critical())
+        col = (uptime_seconds & 1u) ? th->warning : th->status_bar_bg;   /* blink */
+    else if (battery_is_charging())
+        col = th->success;
+    else
+        col = (pct <= 15u) ? th->warning : (pct <= 30u) ? 0xFE00 : th->success;
+
+    /* 13x8 body + 2x4 nub, fill proportional to charge (full while charging). */
+    lcd_fill_rect(BAT_X, 1, BAT_W, BAR_H - 2, th->status_bar_bg);
+    outline(BAT_X, 5, 13, 8, th->text_primary);
+    lcd_fill_rect(BAT_X + 13, 7, 2, 4, th->text_primary);
+    uint16_t fw = battery_is_charging() ? 11u : (uint16_t)((11u * pct + 50u) / 100u);
+    if (fw > 11u) fw = 11u;
+    if (fw)
+        lcd_fill_rect(BAT_X + 1, 6, fw, 6, col);
+    if (battery_is_charging()) {
+        /* small dark bolt on the green fill: two offset 2x2 blocks */
+        lcd_fill_rect(BAT_X + 6, 6, 2, 2, th->status_bar_bg);
+        lcd_fill_rect(BAT_X + 5, 8, 2, 2, th->status_bar_bg);
+        lcd_fill_rect(BAT_X + 6, 10, 2, 2, th->status_bar_bg);
+    }
+}
+
+void scope_topbar_draw(void)
+{
+    const theme_t *th = theme_get();
+    const scope_state_t *ss = scope_state_get();
+
+    lcd_fill_rect(0, 0, LCD_WIDTH, BAR_H, th->status_bar_bg);
+    channel_block(CH1_X, 1u, &ss->ch1, active_channel == 0u, th);
+    channel_block(CH2_X, 2u, &ss->ch2, active_channel == 1u, th);
+    h_block(ss, th);
+    trig_block(ss, th);
+    scope_topbar_draw_battery();
+}
diff --git a/firmware/src/ui/scope_topbar.h b/firmware/src/ui/scope_topbar.h
new file mode 100644
index 0000000..539ebc3
--- /dev/null
+++ b/firmware/src/ui/scope_topbar.h
@@ -0,0 +1,26 @@
+/*
+ * scope_topbar.h — FNIRSI-style status bar for the oscilloscope screen.
+ *
+ * One 18-px bar across the top carries everything the stock FNIRSI UI shows
+ * there: a filled chip per channel (CH1 cyan, CH2 blue) followed by that
+ * channel's volts/div, probe factor and coupling, a green "H" chip with the
+ * timebase, the trigger mode + edge + source in orange, and a battery icon.
+ * The bottom info bar is not drawn in the time-domain scope view any more;
+ * the graticule runs to the bottom of the screen instead.
+ *
+ * Geometry (x slots, font_small advances): see scope_topbar.c.
+ */
+#ifndef SCOPE_TOPBAR_H
+#define SCOPE_TOPBAR_H
+
+#include <stdint.h>
+
+#define SCOPE_TOPBAR_HEIGHT  18
+
+/* Full repaint of the bar (background, chips, H, trigger, battery). */
+void scope_topbar_draw(void);
+
+/* Battery icon only (called once a second by draw_status_bar). */
+void scope_topbar_draw_battery(void);
+
+#endif /* SCOPE_TOPBAR_H */
diff --git a/firmware/src/ui/scope_ui.c b/firmware/src/ui/scope_ui.c
index 35b4903..e860671 100644
--- a/firmware/src/ui/scope_ui.c
+++ b/firmware/src/ui/scope_ui.c
@@ -43,7 +43,9 @@
