+static volatile bool     wake_req;
+static volatile bool     asleep;
+static volatile bool     user_off;            /* dark sleep from POWER/battery: only a button wakes */
+static uint16_t          timeout_min = 5;
+volatile uint8_t         power_off_pending;
+
+bool usb_debug_connected(void);
+
+void power_off_notify_and_wait(void)
+{
+    power_off_pending = 1u;
+    if (usb_debug_connected() && xTaskGetSchedulerState() == taskSCHEDULER_RUNNING)
+        vTaskDelay(pdMS_TO_TICKS(POWER_OFF_NOTICE_MS));
+}
+
+void idle_off_touch(void)
+{
+    last_activity_s = uptime_seconds;
+    if (asleep)
+        wake_req = true;
+}
+
+void idle_off_touch_remote(void)
+{
+    last_activity_s = uptime_seconds;
+    if (asleep && !user_off)                  /* the user switched it off: polling must not undo that */
+        wake_req = true;
+}
+
+uint8_t idle_off_sleep_state(void)
+{
+    return asleep ? (user_off ? 2u : 1u) : 0u;
+}
+
+bool idle_off_asleep(void)
+{
+    return asleep;
+}
+
+void idle_off_set_minutes(uint16_t minutes)
+{
+    timeout_min = minutes;
+    last_activity_s = uptime_seconds;
+}
+
+uint16_t idle_off_get_minutes(void)
+{
+    return timeout_min;
+}
+
+uint32_t idle_off_idle_seconds(void)
+{
+    return uptime_seconds - last_activity_s;
+}
+
+static void wake(void)
+{
+    lcd_display_on();
+    GPIOB->scr = (1U << 8);                   /* backlight on */
+    asleep = false;
+    user_off = false;
+    wake_req = false;
+    last_activity_s = uptime_seconds;
+    ui_modal_active = false;
+    ui_request_redraw_all();
+}
+
+void idle_off_service(void)
+{
+    if (asleep) {
+        if (wake_req)
+            wake();
+        return;
+    }
+    if (timeout_min == 0u || idle_off_idle_seconds() < (uint32_t)timeout_min * 60u)
+        return;
+
+    /* Same sequence as the POWER button (input_handler.c), minus the countdown. */
+    const theme_t *th = theme_get();
+    ui_modal_active = true;                   /* display task drops other draws */
+    vTaskDelay(pdMS_TO_TICKS(120));
+    lcd_fill_rect(60, 80, 200, 80, th->background);
+    font_draw_string_center(160, 100, "Auto power off", th->warning, th->background, &font_medium);
+    font_draw_string_center(160, 125, "no activity", th->text_secondary, th->background, &font_small);
+    vTaskDelay(pdMS_TO_TICKS(800));
+    (void)settings_store_flush((uint32_t)(xTaskGetTickCount() * portTICK_PERIOD_MS));
+    power_off_or_dark_sleep(false);
+}
+
+void power_off_or_dark_sleep(bool by_user)
+{
+    power_off_notify_and_wait();              /* let a connected Pi close its files */
+    GPIOC->clr = (1U << 9);                   /* release the power hold */
+    vTaskDelay(pdMS_TO_TICKS(600));
+
+    /* Still here: USB (VBUS) keeps the rail up. Dark sleep instead. (Before r17 the
+     * POWER button ended in while(1) here, which starved the shell task: frozen
+     * "Goodbye!" screen, USB enumerated but every command timed out, until a reset.) */
+    GPIOC->scr = (1U << 9);                   /* re-arm the hold so a wake is a normal state */
+    GPIOB->clr = (1U << 8);                   /* backlight off */
+    lcd_display_off();
+    wake_req = false;
+    user_off = by_user;
+    asleep = true;
+    power_off_pending = 0u;                   /* still powered (USB): not actually off */
+}
diff --git a/firmware/src/ui/idle_off.h b/firmware/src/ui/idle_off.h
new file mode 100644
index 0000000..ab3ccef
--- /dev/null
+++ b/firmware/src/ui/idle_off.h
@@ -0,0 +1,43 @@
+/*
+ * idle_off.h — auto power-off after N minutes without activity.
+ *
+ * Activity = any button press (input_handle_button) or any shell command
+ * (usb_debug dispatch_command — the Pi viewer's frame polling and every
+ * remote command count, so a connected operator keeps the scope awake).
+ *
+ * After the timeout the device runs the POWER button's own shutdown
+ * sequence (settings flush, PC9 low). On USB power VBUS keeps the rail up,
+ * so if we are still running 600 ms later we fall back to a DARK SLEEP:
+ * backlight off, panel off, display task muted; the next button press or
+ * shell command wakes it (the press itself is swallowed).
+ *
+ * Shell: `idle [off|<minutes>]`. Default 5 minutes (the owner, 2026-10-10).
+ */
+#ifndef IDLE_OFF_H
+#define IDLE_OFF_H
+
+#include <stdint.h>
+#include <stdbool.h>
+
+void     idle_off_touch(void);                /* any task: note activity / request wake */
+void     idle_off_touch_remote(void);         /* shell command: activity; wakes an idle sleep but not a user off */
+uint8_t  idle_off_sleep_state(void);          /* 0 awake, 1 idle dark sleep, 2 switched off by the user (on USB) */
+bool     idle_off_asleep(void);
+void     idle_off_set_minutes(uint16_t minutes);   /* 0 = disabled */
+uint16_t idle_off_get_minutes(void);
+uint32_t idle_off_idle_seconds(void);
+
+/* Power-off notice for a USB host that must close files first (the internal Pi):
+ * sets power_off_pending (reported as off=1 in every SCOPEBIN header) and, if a
+ * CDC host is configured, waits POWER_OFF_NOTICE_MS before returning. Call right
+ * before dropping PC9, from task context. */
+#define POWER_OFF_NOTICE_MS 3000u
+extern volatile uint8_t power_off_pending;
+void power_off_notify_and_wait(void);
+void     idle_off_service(void);              /* display task only, every loop pass */
+/* The shutdown tail shared by the POWER button, auto power-off and battery-critical
+ * paths: notice + PC9 low; if VBUS keeps the rail up, return in DARK SLEEP (the next
+ * button press or shell command wakes the UI). Task context only. */
+void     power_off_or_dark_sleep(bool by_user);   /* by_user: POWER/battery (only a button wakes) */
+
+#endif /* IDLE_OFF_H */
diff --git a/firmware/src/ui/scope_freq_edges.c b/firmware/src/ui/scope_freq_edges.c
new file mode 100644
index 0000000..8d57d23
--- /dev/null
+++ b/firmware/src/ui/scope_freq_edges.c
@@ -0,0 +1,92 @@
+/*
+ * scope_freq_edges.c — see scope_freq_edges.h.
+ *
+ * RAM budget: the image has < 1 KB of SRAM to spare (the v1 streaming command
+ * learned that with 2 KB of statics), so edges live in ONE uint16 array in
+ * 1/16-sample fixed point and the periods are formed in place.
+ */
+#include "scope_freq_edges.h"
+#include <stddef.h>
+
+#define MAX_EDGES 160u                 /* >= 6.4 samples per period at 1024 samples */
+#define SUB       16                   /* fixed-point sub-sample resolution */
+
+static uint16_t edges[MAX_EDGES];      /* edge positions * SUB, then periods * SUB */
+
+static void sort_u16(uint16_t *a, uint16_t n)
+{
+    for (uint16_t i = 1; i < n; i++) {          /* insertion sort, n <= 159 */
+        uint16_t v = a[i];
+        uint16_t j = i;
+        while (j > 0 && a[j - 1] > v) { a[j] = a[j - 1]; j--; }
+        a[j] = v;
+    }
+}
+
+bool scope_freq_edges(const uint8_t *s, uint16_t n, float fs, float *hz)
+{
+    if (s == NULL || n < 16u || fs <= 0.0f)
+        return false;
+
+    uint32_t sum = 0;
+    uint8_t mn = 255u, mx = 0u;
+    for (uint16_t i = 0; i < n; i++) {
+        sum += s[i];
+        if (s[i] < mn) mn = s[i];
+        if (s[i] > mx) mx = s[i];
+    }
+    if ((uint16_t)(mx - mn) < 4u)
+        return false;                            /* flat: nothing to count */
+
+    /* thresholds in 1/16 counts: mean +/- 15 % of the span (hysteresis) */
+    const int32_t mean16 = (int32_t)((sum * 16u + n / 2u) / n);
+    const int32_t hyst16 = (int32_t)(mx - mn) * 16 * 15 / 100;
+    const int32_t hi16 = mean16 + hyst16, lo16 = mean16 - hyst16;
+
+    uint16_t ne = 0;
+    bool state = (int32_t)s[0] * 16 > mean16;
+    for (uint16_t i = 1; i < n && ne < MAX_EDGES; i++) {
+        const int32_t x16 = (int32_t)s[i] * 16;
+        if (state && x16 < lo16) {
+            state = false;
+        } else if (!state && x16 > hi16) {
+            state = true;
+            /* sub-sample edge: the mean-level crossing just before i */
+            uint16_t j = i;
+            while (j > 0 && (int32_t)s[j - 1] * 16 > mean16) j--;
+            int32_t pos16 = (int32_t)j * 16;
+            if (j > 0 && s[j] != s[j - 1]) {
+                /* (j-1) + (mean - s[j-1]) / (s[j] - s[j-1]), in 1/16 */
+                const int32_t num = mean16 - (int32_t)s[j - 1] * 16;        /* 1/16 counts */
+                const int32_t den = (int32_t)s[j] - (int32_t)s[j - 1];     /* counts */
+                pos16 = (int32_t)(j - 1) * 16 + num / den;
+            }
+            if (pos16 < 0) pos16 = 0;
+            edges[ne++] = (uint16_t)pos16;
+        }
+    }
+    if (ne < 3u)
+        return false;
+
+    const uint16_t np = (uint16_t)(ne - 1u);
+    for (uint16_t i = 0; i < np; i++)            /* periods in place */
+        edges[i] = (uint16_t)(edges[i + 1] - edges[i]);
+    sort_u16(edges, np);
+    const uint32_t med16 = (np & 1u) ? edges[np / 2]
+                                     : ((uint32_t)edges[np / 2 - 1] + edges[np / 2]) / 2u;
+    uint32_t tol16 = med16 * 15u / 100u;
+    if (tol16 < 24u) tol16 = 24u;                /* 1.5 samples */
+
+    uint32_t acc = 0, good = 0;
+    for (uint16_t i = 0; i < np; i++) {
+        const uint32_t d = (edges[i] > med16) ? edges[i] - med16 : med16 - edges[i];
+        if (d <= tol16) { acc += edges[i]; good++; }
+    }
+    if (good < 2u)
+        return false;
+    const float p = (float)acc / ((float)good * (float)SUB);
+    if (p < 2.0f)
+        return false;                            /* above Nyquist: refuse */
+    *hz = fs / p;
+    return true;
+}
diff --git a/firmware/src/ui/scope_freq_edges.h b/firmware/src/ui/scope_freq_edges.h
new file mode 100644
index 0000000..b544507
--- /dev/null
+++ b/firmware/src/ui/scope_freq_edges.h
@@ -0,0 +1,22 @@
+/*
+ * scope_freq_edges.h — edge-based frequency estimate for the Freq badge.
+ *
+ * Fallback for scope_freq_estimate() (spectral, declines on ~half of the
+ * records). Rising mean-level crossings with hysteresis, sub-sample
+ * interpolation, and the mean of the cycle periods that agree with their
+ * median — which drops the one broken cycle a free-run record always holds
+ * at the FPGA write-pointer seam. Same estimator the Pi viewer uses
+ * (host/pi_bridge/scope_server.py); worst case 0.25 % on synthetic records
+ * with seams at four positions.
+ */
+#ifndef SCOPE_FREQ_EDGES_H
+#define SCOPE_FREQ_EDGES_H
+
+#include <stdint.h>
+#include <stdbool.h>
+
+/* Returns true and *hz when at least 3 rising edges with a consistent period
+ * were found; false (hz untouched) otherwise. fs = sample rate in S/s. */
+bool scope_freq_edges(const uint8_t *samples, uint16_t n, float fs, float *hz);
+
+#endif /* SCOPE_FREQ_EDGES_H */
