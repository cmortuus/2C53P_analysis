+/* FNIRSI-style graticule, ONE rule shared by the full redraw and the live
+ * compositor (which re-plots the grid arithmetically): 10 x 8 divisions, a dot
+ * every 4 px on the division lines and the frame, the centre cross dotted every
+ * 2 px with 3-px tick marks at every 1/5 division. Returns true and sets *c when
+ * (x, y) is a grid pixel. */
+static inline bool scope_grid_pixel(uint16_t x, uint16_t y, uint16_t *c,
+                                    const theme_t *th)
+{
+    const uint16_t dy = (uint16_t)(y - SCOPE_TOP);
+    const uint16_t cx = LCD_WIDTH / 2;
+
+    if (y == SCOPE_MID_Y && (x & 1u) == 0u)            { *c = th->grid_center; return true; }
+    if (x == cx && (dy & 1u) == 0u)                     { *c = th->grid_center; return true; }
+    if (y + 2 >= SCOPE_MID_Y && y <= SCOPE_MID_Y + 2 && ((x * 5u) % GRID_COL) < 5u)
+                                                        { *c = th->grid_center; return true; }
+    if (x + 2 >= cx && x <= cx + 2 && ((dy * 5u) % GRID_ROW) < 5u)
+                                                        { *c = th->grid_center; return true; }
+    if (((x % GRID_COL) == 0u || x == LCD_WIDTH - 1) && (dy & 3u) == 0u)
+                                                        { *c = th->grid; return true; }
+    if (((dy % GRID_ROW) == 0u || y == SCOPE_BOT - 1) && (x & 3u) == 0u)
+                                                        { *c = th->grid; return true; }
+    return false;
